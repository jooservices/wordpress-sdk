#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

tools/ci/docker-compose run --rm --no-deps php vendor/bin/captainhook install --force --skip-existing

hooks_path="$(git rev-parse --git-path hooks)"

for hook in "${hooks_path}"/*; do
    if [ -f "$hook" ] && grep -q 'vendor/bin/captainhook' "$hook" 2>/dev/null; then
        sed -i 's|vendor/bin/captainhook|tools/run-captainhook|g' "$hook"
    fi
done

echo 'Git hooks installed through Docker: tools/run-captainhook'

{
    "name": "jooservices/wordpress-sdk",
    "description": "A strictly-typed, SOLID-compliant PHP 8.5 SDK for the WordPress REST API",
    "type": "library",
    "keywords": [
        "wordpress",
        "wordpress-rest-api",
        "sdk",
        "dto",
        "application-passwords",
        "content-api"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "JOOservices",
            "email": "admin@jooservices.com"
        }
    ],
    "require": {
        "php": "^8.5",
        "jooservices/client": "^4.2",
        "jooservices/dto": "^3.2",
        "jooservices/exceptions": "^4.0",
        "nyholm/psr7": "^1.8",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "captainhook/captainhook": "^5.23",
        "fakerphp/faker": "^1.24",
        "friendsofphp/php-cs-fixer": "^3.65",
        "laravel/pint": "^1.18",
        "phpmd/phpmd": "^2.15",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^13.0",
        "squizlabs/php_codesniffer": "^3.8 || ^4.0"
    },
    "autoload": {
        "psr-4": {
            "JOOservices\\WordPress\\Sdk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JOOservices\\WordPress\\Sdk\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "ci": [
            "@lint",
            "@test:coverage",
            "@security"
        ],
        "check": [
            "@lint",
            "@test"
        ],
        "lint": [
            "@lint:pint",
            "@lint:phpcs",
            "@lint:phpstan",
            "@lint:phpmd",
            "@lint:cs"
        ],
        "lint:phpcs": "phpcs --standard=phpcs.xml",
        "lint:phpmd": "php -d error_reporting=6143 vendor/bin/phpmd src,tests text phpmd.xml",
        "lint:cs": "php-cs-fixer fix --config=.php-cs-fixer.dist.php --dry-run --diff --sequential",
        "lint:cs:fix": "php-cs-fixer fix --config=.php-cs-fixer.dist.php --sequential",
        "lint:pint": "pint --test",
        "lint:phpstan": "phpstan analyse --no-progress --memory-limit=512M",
        "lint:fix": [
            "pint",
            "@lint:cs:fix"
        ],
        "test": "phpunit --testsuite=Unit",
        "test:integration": "phpunit --testsuite=Integration",
        "test:coverage": [
            "phpunit --testsuite=Unit --coverage-html=coverage --coverage-clover=coverage.xml",
            "@coverage:gate"
        ],
        "coverage:gate": "php tools/test-coverage-gate.php",
        "security": "composer audit --locked",
        "hooks:install": "captainhook install --force --skip-existing"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "captainhook/plugin-composer": true
        },
        "audit": {
            "abandoned": "fail"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
